# Component 1 reads .env from the backend working directory (or shell variables).
# Component 3 reads shell variables only; relative C3 paths use the repository root.
# Never commit .env or put credentials in this example.

# Component 1: apparel inspection and explainability
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/smart_apparel
C1_MODEL_WEIGHTS=../runs/component1_training/E02_optimized/weights/best.pt
C1_MODEL_FREEZE_MANIFEST=../runs/component1_training/freeze/model_freeze_E02_optimized_v1.json
# If an explicit expected hash and freeze manifest are both set, they must agree.
# C1_MODEL_EXPECTED_SHA256=c578003ca158a892ac90de3db7b7552aefabd5292e311c6dd0c76faf717628d3
C1_MODEL_DEVICE=cpu
C1_STORAGE_DIR=./storage
# Local demo only. Set false in shared/deployed environments.
C1_AUTH_DISABLED=true

# Component 3: original seven-day prediction and ranking
# Set these in the shell; they are not automatically loaded from .env.
C3_MODEL_PATH=research/component3/models/c3_7day_sigmoid.joblib
C3_DATA_DIR=C:/path/to/approved/local/Azure/raw
# Isolated v3 preview. OFF by default; seven-day routes still use C3_MODEL_PATH.
C3_EXPERIMENTAL_MULTIHORIZON=false
C3_EXPERIMENTAL_MODEL_PATH=research/component3/experimental_multihorizon_v3/run_003/unpooled_hgb_research.joblib
