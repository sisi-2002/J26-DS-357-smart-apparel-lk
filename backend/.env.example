# Component 1 — Fabric Defect Detection
# Copy to .env and fill in values. Never commit .env to Git.

# Database (async — required from Phase 11.2)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/smart_apparel

# Model weights — absolute path to the frozen E02_optimized checkpoint
C1_MODEL_WEIGHTS=D:/Fabric defect detection/J26-DS-357-smart-apparel-lk/runs/component1_training/E02_optimized/weights/best.pt

# Freeze manifest — if set, C1_MODEL_WEIGHTS is hash-verified against
# selected_experiment.checkpoint_sha256 before loading. A mismatch blocks
# loading rather than silently using the configured file anyway.
C1_MODEL_FREEZE_MANIFEST=D:/Fabric defect detection/J26-DS-357-smart-apparel-lk/runs/component1_training/freeze/model_freeze_E02_optimized_v1.json

# Alternative to the freeze manifest: an explicit expected sha256 (with or
# without the "sha256:" prefix). Takes precedence if both are set.
# C1_MODEL_EXPECTED_SHA256=c578003ca158a892ac90de3db7b7552aefabd5292e311c6dd0c76faf717628d3

# Inference device: cpu or cuda:0
C1_MODEL_DEVICE=cpu

# Image/overlay storage directory
C1_STORAGE_DIR=./storage

# Auth — LOCAL DEMO ONLY. Set to true to skip JWT validation.
# Must be false (or removed) in any shared/deployed environment.
C1_AUTH_DISABLED=true
