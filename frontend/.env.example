# Public browser configuration. Never put credentials in VITE_ variables.
# API root including /api/v1; both components use this base.
VITE_API_BASE_URL=/api/v1
# Server-side Vite proxy target, not bundled into browser code.
API_PROXY_TARGET=http://127.0.0.1:8000
# Experimental preview only; backend flag and audited artifact are also required.
VITE_C3_EXPERIMENTAL_MULTIHORIZON=false
